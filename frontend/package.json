{
  "name": "limitrausch-frontend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build:contracts": "npm --prefix ../contracts run build",
    "predev": "npm run build:contracts",
    "dev": "quasar dev",
    "lint:fix": "prettier --write \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .prettierignore --ignore-path ../.gitignore && eslint --fix -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "lint:check": "prettier --check \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .prettierignore --ignore-path ../.gitignore && eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "prebuild": "npm run build:contracts",
    "build": "quasar build",
    "pretypecheck": "npm run build:contracts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@limitrausch/contracts": "file:../contracts",
    "vue-i18n": "^11.3.0",
    "pinia": "^4.0.2",
    "@quasar/extras": "^2.1.0",
    "quasar": "^2.33.1",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "typescript-eslint": "8.70.1",
    "vite-plugin-checker": "^0.14.5",
    "vue-eslint-parser": "^10.4.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "prettier": "^3.8.1",
    "vue-tsc": "^3.3.3",
    "@types/node": "^22.19.11",
    "@intlify/unplugin-vue-i18n": "^11.0.0",
    "@quasar/app-vite": "^3.10.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "typescript": "6.0.3",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
