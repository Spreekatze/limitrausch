{
  "name": "limitrausch-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:contracts": "npm --prefix ../contracts run build",
    "predev": "npm run build:contracts",
    "dev": "tsx watch index.ts",
    "prebuild": "npm run build:contracts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "pretypecheck": "npm run build:contracts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:fix": "prettier --write \"**/*.{js,mjs,cjs,ts,json,md,yml,yaml}\" --ignore-path .prettierignore --ignore-path ../.gitignore && eslint --fix \"**/*.{js,mjs,cjs,ts}\"",
    "lint:check": "prettier --check \"**/*.{js,mjs,cjs,ts,json,md,yml,yaml}\" --ignore-path .prettierignore --ignore-path ../.gitignore && eslint \"**/*.{js,mjs,cjs,ts}\"",
    "pretest": "npm run build:contracts",
    "test": "vitest run --exclude dist/**",
    "migrate-dry": "npx node-pg-migrate up --dry-run --envPath ../.env",
    "migrate": "npx node-pg-migrate up --envPath ../.env",
    "create-migration": "npx node-pg-migrate create"
  },
  "dependencies": {
    "@limitrausch/contracts": "file:../contracts",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@vitest/ui": "^5.0.3",
    "eslint": "^10.8.0",
    "globals": "^17.4.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "^5.0.3"
  }
}
