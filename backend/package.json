{
  "name": "limitrausch-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "migrate-dry": "npx node-pg-migrate up --dry-run --envPath ../.env",
    "migrate": "npx node-pg-migrate up --envPath ../.env",
    "create-migration": "npx node-pg-migrate create"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@vitest/ui": "^5.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
