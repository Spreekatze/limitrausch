{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/index.ts",
    "src/routes/**/*.ts",
    "src/views/**/*.ts",
    "src/types/**/*.ts",
    "src/middleware/**/*.ts",
    "services/**/*.ts",
    "mapping/**/*.ts",
    "store/**/*.ts",
    "config/**/*.ts",
    "src/database/**/*.ts",
    "data/jobs.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
