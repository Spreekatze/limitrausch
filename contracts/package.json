{
  "name": "@limitrausch/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./eventSchema": {
      "types": "./dist/eventSchema.d.ts",
      "import": "./dist/eventSchema.js"
    },
    "./jobSchema": {
      "types": "./dist/jobSchema.d.ts",
      "import": "./dist/jobSchema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint:fix": "prettier --write \"**/*.{js,mjs,cjs,ts,json,md,yml,yaml}\" --ignore-path ../.gitignore && eslint --fix \"src/**/*.{js,mjs,cjs,ts}\"",
    "lint:check": "prettier --check \"**/*.{js,mjs,cjs,ts,json,md,yml,yaml}\" --ignore-path ../.gitignore && eslint \"src/**/*.{js,mjs,cjs,ts}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "typescript-eslint": "8.70.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  }
}
